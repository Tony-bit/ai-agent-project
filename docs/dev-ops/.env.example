# Copy this file to docs/dev-ops/.env on the cloud host and fill real values there.
# Do not commit docs/dev-ops/.env.

# The Docker network where mysql/redis/pgvector/mem0 containers are already attached.
APP_DOCKER_NETWORK=my-network

# Application
JAVA_OPTS=-Xms512m -Xmx1024m
PARAMS=

# MySQL
SPRING_DATASOURCE_MYSQL_URL=jdbc:mysql://mysql:3306/ai-agent-station?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=false
SPRING_DATASOURCE_MYSQL_USERNAME=
SPRING_DATASOURCE_MYSQL_PASSWORD=

# PgVector/PostgreSQL
POSTGRES_HOST=vector_db
POSTGRES_PORT=5432
POSTGRES_DB=ai-rag-knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

# Redis
REDIS_SDK_CONFIG_HOST=redis
REDIS_SDK_CONFIG_PORT=6379
REDIS_SDK_CONFIG_PASSWORD=

# Mem0
SPRING_AI_ALIBABA_MEM0_CLIENT_BASE_URL=http://mem0:8889
SPRING_AI_ALIBABA_MEM0_CLIENT_TIMEOUT_SECONDS=5

# Model and data provider keys
DASHSCOPE_API_KEY=
AI_DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
TUSHARE_TOKEN=
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SPRING_AI_OPENAI_CHAT_MODEL=glm-4.7

# RAG external services
RAG_RERANK_CONFIG_API_KEY=
RAG_EMBEDDING_CONFIG_API_KEY=

# Langfuse, optional
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
