<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="denny.ai.agent.infrastructure.dao.IChatMessageDao">

    <resultMap id="ChatMessageMap" type="denny.ai.agent.infrastructure.dao.po.ChatMessagePO">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="message_index" property="messageIndex"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="model" property="model"/>
        <result column="latency_ms" property="latencyMs"/>
        <result column="trace_id" property="traceId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="denny.ai.agent.infrastructure.dao.po.ChatMessagePO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_chat_message (
            session_id, message_index, role, content, model, latency_ms, trace_id, create_time
        ) VALUES (
            #{sessionId}, #{messageIndex}, #{role}, #{content}, #{model}, #{latencyMs}, #{traceId}, #{createTime}
        )
    </insert>

    <select id="queryBySessionId" resultMap="ChatMessageMap">
        SELECT id, session_id, message_index, role, content, model, latency_ms, trace_id, create_time
        FROM ai_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY message_index ASC
    </select>

</mapper>
